{
  "$schema": "https://claude.ai/schemas/hooks.json",
  "description": "OmniClaude Delegation Hook - one hook, prompts (UserPromptSubmit) with its history helper; subagents always run on Claude. Switched by the POST_SKILL_DELEGATION_ENFORCER hook bit (OMN-23413 AC39)",
  "version": "1.0.0",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ONEX_DELEGATION_HOOK=prompts ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre_tool_use_delegation.sh",
            "timeout": 300
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${ONEX_DELEGATION_PYTHON} ${CLAUDE_PLUGIN_ROOT}/hooks/lib/delegation_hook_runner.py --history-only 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
