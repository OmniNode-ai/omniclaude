<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ai.omninode.omnidash-lab-dev.plist — canonical-clone Lab dev server (OMN-19732).

  Replaces the hand-installed ai.omninode.omnidash-lab-dev-sync from 2026-09-27.
  On 2026-09-28 its ticket worktree was pruned, leaving every tick failing.
  The power outage at 11:15Z also exposed that restarting only on HEAD changes
  could not recover vite after reboot. This agent serves OMNI_HOME/omnidash
  every 120 seconds and starts vite when absent or when the served HEAD moves.
  It never writes git state: ai.omninode.canonical-clone-sync keeps the canonical
  clone on origin/dev every 180 seconds. Dependencies are installed when absent
  or when the lockfile changes. Per-machine VITE_PROJECTION_API_URL and
  VITE_PROJECTION_TENANT_ID may be sourced from HOME/.omnibase/omnidash-lab-dev.env
  (override with OMNIDASH_LAB_DEV_ENV_FILE); only exported names are logged.

  AbandonProcessGroup preserves the detached dev server after each tick exits.
  KeepAlive stays false because the tick itself is periodic, not a daemon.
  Template: __OMNI_HOME__ and __HOME__ are expanded by tick-bundle-install.sh.

  Uninstall the old agent before installing this replacement:
    launchctl bootout gui/$(id -u)/ai.omninode.omnidash-lab-dev-sync
    rm ~/Library/LaunchAgents/ai.omninode.omnidash-lab-dev-sync.plist

  Install this label using the installer's only-label option.
  Uninstall this agent:
    launchctl bootout gui/$(id -u)/ai.omninode.omnidash-lab-dev
    rm ~/Library/LaunchAgents/ai.omninode.omnidash-lab-dev.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.omninode.omnidash-lab-dev</string>

  <key>ProgramArguments</key>
  <array>
    <string>__OMNI_HOME__/omniclaude/scripts/omnidash-lab-dev-tick.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>120</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <false/>

  <key>AbandonProcessGroup</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/omnidash-lab-dev-tick-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/omnidash-lab-dev-tick-stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>OMNI_HOME</key>
    <string>__OMNI_HOME__</string>
    <key>ONEX_STATE_DIR</key>
    <string>__OMNI_HOME__/.onex_state</string>
  </dict>
</dict>
</plist>
