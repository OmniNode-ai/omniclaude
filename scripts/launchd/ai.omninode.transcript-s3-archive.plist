<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ai.omninode.transcript-s3-archive.plist — launchd agent for the daily Claude
  Code session-transcript sync to the encrypted S3 archive
  (OMN-18189, OMN-19513).

  Runs transcript-s3-archive-sync.sh once daily. That script invokes the
  canonical archive_claude_sessions.sh already in omninode_infra (--yes,
  non-interactive) against the discovered archive bucket and its KMS key, and
  reads back the object count/size afterward. It authenticates as whatever
  AWS_PROFILE is set below (default: the "default" SSO profile); if that
  session has expired, the run fails closed rather than creating or rotating
  a credential.

  Uses StartCalendarInterval for a daily schedule (launchd ignores
  StartInterval when StartCalendarInterval is present). 04:30 local, clear of
  the 02:00 nightly-merge-sweep tick.

  Template: __OMNI_HOME__ and __HOME__ are expanded at install time by
  tick-bundle-install.sh.

  Install:
    bash omniclaude/scripts/tick-bundle-install.sh

  Uninstall:
    bash omniclaude/scripts/tick-bundle-uninstall.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.omninode.transcript-s3-archive</string>

  <key>ProgramArguments</key>
  <array>
    <string>__OMNI_HOME__/omniclaude/scripts/transcript-s3-archive-sync.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/transcript-s3-archive-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/transcript-s3-archive-stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>OMNI_HOME</key>
    <string>__OMNI_HOME__</string>
    <key>AWS_PROFILE</key>
    <string>default</string>
  </dict>

  <key>KeepAlive</key>
  <false/>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
