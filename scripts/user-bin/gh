#
# ONEX_GH_USER_SHIM (OMN-19479) -- a `gh` shim installed ahead of the real
# binary on this host's PATH (scripts/user-bin/install-gh-shim.sh).
#
# Why: the Claude Code harness looks up the current branch's PR link with
# `gh pr view [<branch>] --json url` every few seconds per session, and every
# lookup spends the operator's shared GitHub quota (2026-09-24 plan M4: at
# least 355 GraphQL requests an hour from two sessions). This shim answers
# exactly two read shapes from a 600 s per-(repository, branch) cache and
# hands every other command to the real `gh` unchanged:
#
#   gh pr view [<branch>] --json url
#   gh pr view [<branch>] --json number,url,state
#
# Before it reads that cache the shim asks the PR watcher's state file (OMN-19479): a fresh
# state naming exactly one open PR whose head branch is the one asked about answers the
# lookup with no GitHub call, logged cache=watcher; anything else (no state, a stale
# tick, no jq, a branch with no open PR) runs the real gh as before.
#
# Nothing else is cached. A PR mutation that can change those answers
# (create, ready, close, reopen, merge) purges the cache before it runs.
# A cached "no pull requests found" answer is kept like a positive one; any
# other failure (network, quota, auth) is never cached.
#
# Read routing (OMN-19587): with ONEX_GH_READ_ROUTING=1, the read shapes
# `gh api` GET/HEAD, `pr view|list|checks|diff`, `run view|list`, `repo view`,
# `issue view|list` and `search` are candidates handed to gh_route.py
# (installed next to this file by install-gh-shim.sh; override with
# ONEX_GH_ROUTER); gh_route.py's own classify() is the authority on whether a
# given call actually reads (a viewer-resolving query or a non-OmniNode-ai
# owner still runs on the operator there). `api graphql` is never a
# candidate here: this shim cannot tell a mutation from a read without
# parsing the query the way gh_route.py does, so no graphql call reaches the
# router process at all -- every graphql call, mutation or read, runs on the
# operator unchanged, cleanly. It runs an actual read on the read-only App
# token from
# GH_READ_TOKEN_CMD and falls back to the operator credential when there is
# none. Every other call, and every write, runs on the operator unchanged and
# never reaches the router. With the flag unset or anything but 1 the shim
# runs the real gh exactly as it did before routing existed. Both variables
# default from ~/.config/omni/gh-read-routing.env when unset (OMN-19852).
#
# Search guard (OMN-19852): GitHub's secondary-rate-limited search bucket is
# reserved for the launchd PR watcher. `gh api search/...` and `gh search ...`
# are refused unless ONEX_PR_WATCHER=1; readers use the watcher's local state
# and the canonical clones instead.
#
# PR-state read guard (OMN-19856): `gh pr view|checks`, `gh run view` and the `gh api`
# GET/HEAD reads of pulls, check-runs, check-suites, commit statuses, actions/runs and
# actions/jobs are refused unless the caller is the PR watcher or the landing controller's
# own process, or the call is a declared exact-head check (RULING 2026-09-27T18:05:21Z).
# Full contract at the guard, below the search guard.
#
# Lane read guard (OMN-20911): from a lane context (an agent environment marker, or a
# Claude Code / Codex / ChatGPT ancestor process) every other GitHub read falls back to the
# cached read gateway and its per-hour budget, logged `fallback`, until its verb is set
# strict in gh-gateway.env; a strict verb is refused with the local reader named. Writes
# stay allowed. Failing-job logs, one check run's detail and one commit object by full sha
# (OMN-20960) go through the same gateway (RULING 2026-10-10T18:17:36Z; fallback per the
# 2026-10-12T05:03:28Z ruling). Full contract at the guard, below the PR-state guard.
#
# Lane write guard (OMN-20914): from a lane, a gh write that `onex scm` serves (read from
# the operations table of node_github_repo_write_effect's contract in the omnimarket the
# `onex` command runs) is refused, naming the `onex scm` verb that replaces it. A write with
# no onex scm operation stays allowed. Full contract at the guard, below the PR-state guard.
#
# Logged fallback (OMN-20911, RULING 2026-10-12T05:03:28Z): a few named consumers whose
# replacement path does not work yet keep their old call through both lane guards, and
# every such use appends one FRICTION row. List and contract at _fb_match.
#
# Shared call log (OMN-19852): every allowed or refused call appends one
# tab-separated line to ONEX_GH_CALLS_LOG, else ONEX_STATE_DIR/gh-calls.log
# (no log is written when neither is set).
# It contains only timestamp, resolved lane/source, class, method, endpoint,
# exit code and action -- never argv, environment values or tokens.
# ONEX_GH_USAGE_LOG=0 turns both usage logs off for one call.
#
# Usage log (OMN-19585): every invocation appends one JSON line to
# ${XDG_CACHE_HOME:-$HOME/.cache}/omni/gh-usage/<UTC date>.jsonl with the
# timestamp, lane (ONEX_LANE; else ONEX_LANE_ID, ONEX_AGENT_NAME,
# CLAUDE_AGENT_NAME or CLAUDE_SUBAGENT_NAME; else the lane registered for the
# omni_worktrees/<ticket>/<dir> worktree the call is made from; else the Claude
# Code session id; else script:<name> when the parent is an interpreter running
# a .py/.sh/.js/.mjs script (lane_source=script); else the parent command, with
# lane_source saying which),
# command class, HTTP method, repository, endpoint path (gh api only,
# query string dropped), exit code and whether the cache answered. With routing
# on it adds identity (app, operator, operator-fallback) and route_reason. Argv, stdin,
# output and environment values are never written, so no token can reach it.
# Every line also carries parent (ONEX_PARENT_LANE, the dispatching lane) and
# host (ONEX_LANE_HOST, else the short $HOSTNAME), "" when unknown (OMN-20420);
# the gh-calls.log TSV stays at 8 columns.
# scripts/user-bin/gh_usage_report.py turns the log into requests per lane.
# ONEX_GH_USAGE_LOG=0 turns the log off for one call.
#
# Gateway read marking (OMN-17427, phase a): JSON usage lines mark reads as
# gateway (ONEX_GH_GATEWAY=1) or bypass, and non-reads as "". Bypass reads warn
# before execution for attributed sessions/lanes or a terminal, unless
# ONEX_GH_WARN=0; ONEX_GH_WARN=1 opts programs in. The two cached harness
# PR-link shapes never warn, hit or miss: the harness asks every few seconds
# and phase (c) answers them from the PR-state projection.
# Last-resort attribution names known caller roles through up to six ancestors,
# then the direct parent's script, module or command. Roles never grant access.
#
# This file must stay bash 3.2 compatible: /bin/bash on macOS is 3.2.

ONEX_GH_SHIM_TTL="${ONEX_GH_SHIM_TTL:-600}"

# --- find the real gh: walk PATH past this file and any other shim copy -----
self="${BASH_SOURCE[0]}"
real=""
# PATH is split by parameter expansion, not `read <<< "$PATH"`: under Homebrew
# bash 5.3.9 a here-string read of this host's 1.6 kB PATH hung twice at
# 2026-09-25T14:52Z (load average 72) and did not reproduce at 15:05Z. The
# shim must never be able to hang a gh call, and this form has no temp file.
_rest="$PATH:"
while [ -n "$_rest" ]; do
  _d="${_rest%%:*}"
  _rest="${_rest#*:}"
  [ -n "$_d" ] || continue
  _c="$_d/gh"
  [ -f "$_c" ] && [ -x "$_c" ] || continue
  [ "$_c" -ef "$self" ] && continue
  # Another copy of this shim (a second install, or the source tree on PATH)
  # would recurse forever; skip anything carrying the marker.
  if head -c 512 "$_c" 2>/dev/null | grep -q 'ONEX_GH_USER_SHIM'; then
    continue
  fi
  real="$_c"
  break
done
if [ -z "$real" ]; then
  echo "gh shim (OMN-19479): no real gh found on PATH after $self" >&2
  exit 127
fi

# --- read-routing defaults (OMN-19852) -----------------------------------------
# A session, a launchd job and a Codex lane each start with their own environment,
# so an exported flag reaches only the shells that happened to inherit it. When
# ONEX_GH_READ_ROUTING or GH_READ_TOKEN_CMD is unset, take it from the one host
# file ${XDG_CONFIG_HOME:-$HOME/.config}/omni/gh-read-routing.env (KEY=VALUE
# lines; only these two keys are read, nothing is evaluated). The environment
# wins, so ONEX_GH_READ_ROUTING=0 still turns routing off for one call.
#
# A trailing " # note" on the same line as the value (an operator's own
# disable annotation is the observed case, OMN-19852) is stripped, comment and
# the whitespace before it: without this, "ONEX_GH_READ_ROUTING=1  # re-enabled"
# would compare unequal to "1" and silently run every read on the operator
# while the file reads enabled.
_conf_strip_comment_into() {
  local v="$2"
  case "$v" in *[[:space:]]'#'*) v="${v%%[[:space:]]\#*}" ;; esac
  while :; do
    case "$v" in
      *[[:space:]]) v="${v%[[:space:]]}" ;;
      *) break ;;
    esac
  done
  printf -v "$1" '%s' "$v"
}
_conf_v=""
_routing_conf="${ONEX_GH_READ_ROUTING_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/omni/gh-read-routing.env}"
if [ -f "$_routing_conf" ] && { [ -z "${ONEX_GH_READ_ROUTING+x}" ] || [ -z "${GH_READ_TOKEN_CMD+x}" ]; }; then
  while IFS= read -r _line || [ -n "$_line" ]; do
    case "$_line" in
      ONEX_GH_READ_ROUTING=*)
        if [ -z "${ONEX_GH_READ_ROUTING+x}" ]; then
          _conf_strip_comment_into _conf_v "${_line#*=}"
          export ONEX_GH_READ_ROUTING="$_conf_v"
        fi ;;
      GH_READ_TOKEN_CMD=*)
        if [ -z "${GH_READ_TOKEN_CMD+x}" ]; then
          _conf_strip_comment_into _conf_v "${_line#*=}"
          export GH_READ_TOKEN_CMD="$_conf_v"
        fi ;;
    esac
  done < "$_routing_conf"
fi

_cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/omni/gh-shim/prview"

# These reads describe this invocation. Reuse them across guards and logs rather
# than starting git or date again for the same working directory and call.
_origin_done=0
_origin_url=""
_origin=""
_read_origin() {
  [ "$_origin_done" -eq 1 ] && return 0
  _origin_done=1
  _origin_url="$(git config --get remote.origin.url 2>/dev/null)"
  _origin="${_origin_url%.git}"
  _origin="${_origin##*:}"
  case "$_origin" in */*/*) _origin="${_origin#"${_origin%/*/*}"/}" ;; esac
}

_call_timestamp=""
_read_timestamp() {
  [ -n "$_call_timestamp" ] || _call_timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

# Bash 3.2 has no ${value^^}. The strict-config key is ASCII, so translate in
# this shell instead of starting a pipeline for every guarded read.
_ascii_upper_into() {
  local value="$2" lower=abcdefghijklmnopqrstuvwxyz upper=ABCDEFGHIJKLMNOPQRSTUVWXYZ i
  for ((i=0; i<26; i++)); do
    value="${value//${lower:i:1}/${upper:i:1}}"
  done
  printf -v "$1" '%s' "$value"
}

# --- usage log (OMN-19585) -----------------------------------------------------

# Keep only characters that are safe inside a log value and meaningful in a
# repo, endpoint or lane name, and blank anything shaped like a GitHub token.
_clean_into() {
  local v="$2"
  v="${v//[^A-Za-z0-9._\/:@+=, -]/}"
  case "$v" in
    *ghp_*|*gho_*|*ghu_*|*ghs_*|*ghr_*|*github_pat_*) v="REDACTED" ;;
  esac
  printf -v "$1" '%s' "${v:0:200}"
}

_clean() {
  local cleaned=""
  _clean_into cleaned "$1"
  printf '%s' "$cleaned"
}

# Optional launcher context from the remote-lane runner (OMN-20420): the
# orchestrator lane that dispatched this one and the host it runs on. Both are
# usage-log (JSONL) fields only; the call-log TSV keeps its 8 columns.
_parent_lane=""; _lane_host=""
_resolve_parent_host() {
  _clean_into _parent_lane "${ONEX_PARENT_LANE:-}"
  if [ -n "${ONEX_LANE_HOST:-}" ]; then
    _clean_into _lane_host "$ONEX_LANE_HOST"
  else
    _clean_into _lane_host "${HOSTNAME%%.*}"
  fi
}

# Resolve attribution once for both the usage line and the read router.
_lane_done=0
_resolve_lane() {
  [ "$_lane_done" -eq 1 ] && return 0
  _lane_done=1
  _lane=""; _lane_src=""
  local agent="" cwd="" suffix="" ticket="" repo_dir="" worktree=""
  local registry_dir="" record="" hash="" registered="" parent="" pargs="" script="" w=""
  local pid="$PPID" steps=0 next="" info="" direct_args="" role="" job=0 module="" rest=""
  if [ -n "${ONEX_LANE:-}" ]; then
    _clean_into _lane "$ONEX_LANE"; _lane_src="env"
    return
  fi
  if [ -n "${ONEX_LANE_ID:-}" ]; then agent="$ONEX_LANE_ID"
  elif [ -n "${ONEX_AGENT_NAME:-}" ]; then agent="$ONEX_AGENT_NAME"
  elif [ -n "${CLAUDE_AGENT_NAME:-}" ]; then agent="$CLAUDE_AGENT_NAME"
  elif [ -n "${CLAUDE_SUBAGENT_NAME:-}" ]; then agent="$CLAUDE_SUBAGENT_NAME"
  fi
  if [ -n "$agent" ]; then
    _clean_into _lane "$agent"; _lane_src="agent-env"
    return
  fi
  cwd="$(pwd -P 2>/dev/null)"
  case "$cwd" in
    */omni_worktrees/*/*)
      suffix="${cwd#*/omni_worktrees/}"
      ticket="${suffix%%/*}"
      suffix="${suffix#*/}"
      repo_dir="${suffix%%/*}"
      worktree="${cwd%%/omni_worktrees/*}/omni_worktrees/$ticket/$repo_dir"
      if [ -n "${ONEX_LANE_REGISTRY_ROOT:-}" ]; then
        registry_dir="$ONEX_LANE_REGISTRY_ROOT/lane_identity"
      elif [ -n "${OMNI_HOME:-}" ]; then
        registry_dir="$OMNI_HOME/.onex_state/lane_identity"
      fi
      if [ -n "$registry_dir" ]; then
        hash="$(_sha "$worktree" | cut -c1-32)"
        record="$registry_dir/$hash.json"
        if [ -n "$hash" ] && [ -r "$record" ]; then
          registered="$(sed -n 's/.*"lane"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$record" 2>/dev/null | head -n 1)"
          if [ -n "$registered" ]; then
            _lane="$(_clean "$registered")"; _lane_src="registry"
            return
          fi
        fi
      fi
      ;;
  esac
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
    _lane="session:$(_clean "$CLAUDE_CODE_SESSION_ID")"; _lane_src="session"
    return
  fi
  # Phase (a) of the GitHub gateway plan (OMN-17427): roles are attribution
  # only and never grant anything. The PR-state guard's allow decision stays
  # direct-parent-only (see _prs_caller_allowed). This walk runs only when no
  # env/registry/session attribution exists.
  while [ "$steps" -lt 6 ]; do
    case "$pid" in ""|*[!0-9]*) break ;; esac
    [ "$pid" -gt 1 ] || break
    # "<ppid> <args...>", split by parameter expansion like PATH above: no word
    # splitting and no glob expansion of the ancestor's command line.
    info="$(ps -ww -o ppid= -o args= -p "$pid" 2>/dev/null)"
    info="${info#"${info%%[![:space:]]*}"}"
    [ -n "$info" ] || break
    next="${info%%[[:space:]]*}"
    pargs="${info#"$next"}"
    pargs="${pargs#"${pargs%%[![:space:]]*}"}"
    # A role is named by the interpreter and script at the head of the command line. An
    # ancestor such as a headless `claude -p` carries its whole prompt in argv (150 kB
    # measured, OMN-20911), and the word loop below over that never finished within 30 s,
    # so only the head is read: the shim must never be able to hang a gh call.
    pargs="${pargs:0:4096}"
    [ "$steps" -eq 0 ] && direct_args="$pargs"
    role=""; job=0
    case "$pargs" in *omnibase_internal.pr_watcher*) role="pr-watcher" ;; esac
    rest="$pargs "
    while [ -z "$role" ] && [ -n "$rest" ]; do
      w="${rest%% *}"
      rest="${rest#* }"
      [ -n "$w" ] || continue
      if [ "$job" -eq 1 ]; then role="$w"; break; fi
      case "${w##*/}" in
        landing_controller.py) role="landing-controller" ;;
        landing_worker_run.py) role="landing-worker" ;;
        landing_lab_prover.py) role="landing-lab-prover" ;;
        onex_remote_lane.py) role="remote-lane-runner" ;;
        morning_workflows_tick.sh) job=1 ;;
      esac
    done
    if [ -n "$role" ]; then
      _lane="role:$(_clean "$role")"; _lane_src="role"
      return
    fi
    pid="$next"
    steps=$((steps + 1))
  done
  # No known role: the direct parent's script, module or command, as before.
  rest="$direct_args "
  w="${rest%% *}"
  rest="${rest#* }"
  parent="$(basename "$w" 2>/dev/null)"
  case "$parent" in
    python|Python|python3*|bash|sh|zsh|node|uv|ruby)
      # Only the first non-option word can be the script; `-m <module>` runs a
      # module, so a later .py word (`python -m pytest tests/x.py`) is an argument.
      while [ -n "$rest" ]; do
        w="${rest%% *}"
        rest="${rest#* }"
        [ -n "$w" ] || continue
        case "$w" in
          -m) rest="${rest#"${rest%%[![:space:]]*}"}"; module="${rest%% *}"; break ;;
          -*) continue ;;
          *.py|*.sh|*.js|*.mjs) script="$(basename "$w" 2>/dev/null)" ;;
        esac
        break
      done
      ;;
  esac
  if [ -n "$module" ]; then
    _lane="module:$(_clean "$module")"; _lane_src="module"
    return
  fi
  if [ -n "$script" ]; then
    _lane="script:$(_clean "$script")"; _lane_src="script"
    return
  fi
  _lane="parent:$(_clean "$parent")"; _lane_src="parent"
}

# Sets _cls, _method and _repo, _endpoint for the argv in "$@".
_classify() {
  _cls=""; _method=""; _repo=""; _endpoint=""
  local group="${1:-}" sub="${2:-}" a prev="" repo_flag="" has_field=0 is_mutation=0
  for a in "$@"; do
    case "$prev" in
      -R|--repo) repo_flag="$a" ;;
      -X|--method) _method="$a" ;;
    esac
    case "$a" in
      --repo=*) repo_flag="${a#--repo=}" ;;
      --method=*) _method="${a#--method=}" ;;
      -f|-F|--field|--raw-field|--input|--field=*|--raw-field=*|--input=*) has_field=1 ;;
    esac
    case "$a" in *mutation*) is_mutation=1 ;; esac
    prev="$a"
  done
  if [ "$group" = "api" ]; then
    # First positional after `api` that is not the value of an option.
    local skip=0
    shift
    for a in "$@"; do
      if [ "$skip" -eq 1 ]; then skip=0; continue; fi
      case "$a" in
        -X|--method|-H|--header|-f|--raw-field|-F|--field|--input|-q|--jq|-t|--template|--cache|--hostname|-p|--preview) skip=1 ;;
        -*) ;;
        *) _endpoint="${a%%\?*}"; break ;;
      esac
    done
    _endpoint="${_endpoint#/}"
    if [ "$_endpoint" = "graphql" ]; then
      _cls="api graphql"
      if [ "$is_mutation" -eq 1 ]; then _method="MUTATION"; else _method="POST"; fi
    else
      _cls="api"
      if [ -z "$_method" ]; then
        if [ "$has_field" -eq 1 ]; then _method="POST"; else _method="GET"; fi
      fi
      case "$_endpoint" in
        repos/*/*) _repo="${_endpoint#repos/}"; _repo="${_repo#*/}"; _repo="${_repo%%/*}" ;;
      esac
    fi
    _method="$(printf '%s' "$_method" | tr '[:lower:]' '[:upper:]')"
  else
    case "$sub" in
      ""|-*) _cls="$group" ;;
      *) _cls="$group $sub" ;;
    esac
    case "$group" in
      ""|-*|auth|config|alias|extension|help|completion|version|status) _method="LOCAL" ;;
      search|browse) _method="GET" ;;
      *)
        case "$sub" in
          view|list|checks|diff|status|download|watch|ls) _method="GET" ;;
          *) _method="WRITE" ;;
        esac
        ;;
    esac
    [ "$group" = "status" ] && _method="GET"
    if [ -n "$repo_flag" ]; then
      _repo="${repo_flag##*/}"
    else
      case "$group" in
        pr|issue|run|workflow|release|label|repo|cache|ruleset)
          _read_origin
          _repo="$_origin_url"
          _repo="${_repo%.git}"; _repo="${_repo##*/}"; _repo="${_repo##*:}"
          ;;
      esac
    fi
  fi
}

# _call_log <exit code> <action: allowed|refused|fallback>
_call_log() {
  [ "${ONEX_GH_USAGE_LOG:-1}" = "0" ] && return 0
  local file="" dir="" ts="" oversized="" value="" cleaned=""
  local log_fields=()
  if [ -n "${ONEX_GH_CALLS_LOG:-}" ]; then
    file="$ONEX_GH_CALLS_LOG"
  elif [ -n "${ONEX_STATE_DIR:-}" ]; then
    file="$ONEX_STATE_DIR/gh-calls.log"
  else
    return 0
  fi
  case "$file" in
    */*) dir="${file%/*}" ;;
    *) dir="." ;;
  esac
  mkdir -p "$dir" 2>/dev/null || return 0
  if [ $(( $$ % 50 )) -eq 0 ] && [ -f "$file" ]; then
    oversized="$(find "$file" -prune -type f -size +20480k -print 2>/dev/null)"
    if [ -n "$oversized" ]; then
      mv -f "$file" "$file.1" 2>/dev/null || true
    fi
  fi
  _resolve_lane
  _read_timestamp
  ts="$_call_timestamp"
  # Sanitize in this shell: command substitution would fork once per field.
  for value in "$ts" "$_lane" "$_lane_src" "$_cls" "$_method" "$_endpoint" "$1" "$2"; do
    _clean_into cleaned "$value"
    log_fields+=("$cleaned")
  done
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${log_fields[@]}" >> "$file" 2>/dev/null || true
}

# _refusal_row <guard> <reason class> <detail>   (OMN-21020)
# Writes one class=refusal row for a refusal through the refusal recorder's shell entry
# (plugins/onex/hooks/lib/hook_refusal.sh), the same seam every hook guard records through:
# the recorder resolves the lane, redacts, dedupes and carries the suppressed count. Only the
# two gates the call log alone used to hold call this: the lane read (OMN-20911) and the
# covered write (OMN-20914). The seam is the canonical clone's, or ONEX_HOOK_REFUSAL_SEAM.
# Fail-open by construction: a seam that cannot be found or run never changes the refusal,
# which the caller has already decided.
_refusal_row() {
  local seam="${ONEX_HOOK_REFUSAL_SEAM:-}"
  if [ -z "$seam" ] && [ -n "${OMNI_HOME:-}" ]; then
    seam="$OMNI_HOME/omniclaude/plugins/onex/hooks/lib/hook_refusal.sh"
  fi
  [ -n "$seam" ] && [ -r "$seam" ] || return 0
  (
    _OMNICLAUDE_HOOK_NAME="$1"
    _OMNICLAUDE_HOOK_PAYLOAD='{}'
    ONEX_REGISTRY_ROOT="${ONEX_REGISTRY_ROOT:-${OMNI_HOME:-}}"
    # shellcheck source=/dev/null
    source "$seam" || exit 0
    hook_record_refusal "$2" "$3"
  ) || true
  return 0
}

# _log <exit code> <cache: hit|miss|none> [call-log action, default allowed]
_log() {
  [ "${ONEX_GH_USAGE_LOG:-1}" = "0" ] && return 0
  _call_log "$1" "${3:-allowed}"
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/omni/gh-usage"
  local ts session ticket="" identity="" route_reason=""
  local cls="" method="" repo="" endpoint=""
  _read_timestamp
  ts="$_call_timestamp"
  _clean_into session "${CLAUDE_CODE_SESSION_ID:-}"
  case "$PWD" in
    */omni_worktrees/OMN-*) ticket="${PWD#*/omni_worktrees/}"; ticket="${ticket%%/*}" ;;
  esac
  mkdir -p "$dir" 2>/dev/null || return 0
  _resolve_lane
  _resolve_parent_host
  _clean_into ticket "$ticket"
  _clean_into cls "$_cls"
  _clean_into method "$_method"
  _clean_into repo "$_repo"
  _clean_into endpoint "$_endpoint"
  if [ -n "$_route" ]; then
    identity="${_route%% *}"
    case "$_route" in *\ *) route_reason="${_route#* }" ;; esac
    _clean_into identity "$identity"
    _clean_into route_reason "$route_reason"
    printf '{"ts":"%s","lane":"%s","lane_source":"%s","session":"%s","ticket":"%s","cls":"%s","method":"%s","repo":"%s","endpoint":"%s","exit":%s,"cache":"%s","identity":"%s","route_reason":"%s","parent":"%s","host":"%s","pid":%s,"gateway":"%s"}\n' \
      "$ts" "$_lane" "$_lane_src" "$session" "$ticket" "$cls" "$method" \
      "$repo" "$endpoint" "$1" "$2" "$identity" "$route_reason" "$_parent_lane" "$_lane_host" "$$" "$_gateway" \
      >> "$dir/${ts%%T*}.jsonl" 2>/dev/null || true
  else
    printf '{"ts":"%s","lane":"%s","lane_source":"%s","session":"%s","ticket":"%s","cls":"%s","method":"%s","repo":"%s","endpoint":"%s","exit":%s,"cache":"%s","parent":"%s","host":"%s","pid":%s,"gateway":"%s"}\n' \
      "$ts" "$_lane" "$_lane_src" "$session" "$ticket" "$cls" "$method" \
